# --- Secrets & environment (never commit) ---
.env
.env.*
!.env.example
.env.local
*.pem
*.key
secrets/
*.secret
.venv/
venv/
env/

# --- Data & artifacts ---
*.parquet
data/raw/
data/processed/
*.mat
*.zip
*.pkl
*.joblib
*.pt
*.pth
artifacts/
checkpoints/

# --- Markdown: allow only README and supplement docs ---
*.md
!README.md
!**/README.md
!SUPPLEMENT*.md
!**/SUPPLEMENT*.md
!docs/*.md
!**/docs/*.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# --- IDE & OS ---
.idea/
.vscode/
.DS_Store

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
