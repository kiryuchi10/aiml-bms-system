# --- Secrets & environment (never commit) ---
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.production.local
*.pem
*.key
secrets/

# --- Dependencies & build ---
node_modules/
dist/
*.local

# --- Markdown: allow only README and supplement docs ---
*.md
!README.md
!**/README.md
!SUPPLEMENT*.md
!**/SUPPLEMENT*.md
!docs/*.md
!**/docs/*.md

# --- Logs & cache ---
*.log
npm-debug.log*
.npm
.eslintcache

# --- IDE & OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Optional ---
coverage/
*.tsbuildinfo
