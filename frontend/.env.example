# Frontend (Vite)
# 1) 백엔드를 별도 실행(8000)할 때: 아래처럼 명시
# VITE_API_BASE=http://localhost:8000/api/v1
# VITE_BMS_WS_URL=ws://localhost:8000/ws/bms
#
# 2) 프록시 사용(같은 오리진): 비워두면 /api/v1, ws://현재호스트/ws/bms 로 요청 → vite가 8000으로 프록시
# VITE_API_BASE=
# VITE_BMS_WS_URL=
#
# WS Disconnected 시: 백엔드 /ws/bms 라우트 존재 여부, data 폴더에 .mat/.parquet 존재 여부 확인
VITE_API_BASE=http://localhost:8000/api/v1
VITE_BMS_WS_URL=ws://localhost:8000/ws/bms
